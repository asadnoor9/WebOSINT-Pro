# WebOSINT Pro - example environment file
#
# Copy to .env and fill in your own values:
#     cp .env.example .env
#
# .env is git-ignored. NEVER commit real credentials.
# All values below are placeholders only.

# ── Optional API keys ────────────────────────────────────────────────────────
# API keys are read from the environment only. They are never accepted on the
# command line or from config.json, so they cannot leak into shell history.
# Every key is optional; the related module is skipped when a key is absent.

# Shodan host enrichment - https://account.shodan.io/
WEBOSINT_SHODAN_KEY=your-shodan-api-key-here

# NVD CVE lookups - https://nvd.nist.gov/developers/request-an-api-key
WEBOSINT_NVD_KEY=your-nvd-api-key-here

# ── Optional defaults ────────────────────────────────────────────────────────
# These mirror the CLI flags. CLI arguments always win.

# Data minimization: minimal | standard | detailed
WEBOSINT_DETAIL=standard

# Report output directory
WEBOSINT_OUTPUT_DIR=reports

# Log directory
WEBOSINT_LOG_DIR=logs

# Retention in days for generated reports and logs
WEBOSINT_RETENTION_DAYS=30
WEBOSINT_LOG_RETENTION_DAYS=14

# Networking defaults
WEBOSINT_TIMEOUT=15
WEBOSINT_THREADS=10
WEBOSINT_RATE_LIMIT=5

# Optional outbound proxy, for example http://127.0.0.1:8080
# WEBOSINT_PROXY=

# Telemetry is disabled and there is no analytics or outbound reporting.
# This variable exists only to document that fact.
WEBOSINT_TELEMETRY=false
