# WebOSINT Pro - web interface (start on boot)
#
# Installed by scripts/install-service.sh, which fills in the user and paths.
# systemd supervises the process directly, so do NOT pass --background here.

[Unit]
Description=WebOSINT Pro web interface
Documentation=file://__WORKDIR__/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__WORKDIR__
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-__WORKDIR__/.env
ExecStart=__PYTHON__ __WORKDIR__/webserve.py __ARGS__
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM

# --- Hardening: the service only needs to read the repo and write reports ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__WORKDIR__/reports __WORKDIR__/logs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
