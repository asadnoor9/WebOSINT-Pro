# ── Scan output and generated artifacts ───────────────────────────────────
# NOTE: reports/ also holds the report-writer source code, so ignore only the
# generated output inside it rather than the whole package.
reports/*.json
reports/*.html
reports/*.md
reports/*.csv
reports/*.xml
reports/*.docx
reports/*.pdf
reports/web/
!reports/__init__.py
output/
outputs/
results/
scans/
artifacts/
webosint_*.json
webosint_*.html
webosint_*.md

